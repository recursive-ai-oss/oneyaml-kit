<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared plumbing for the .NET adapters: the JSON Lines protocol loop, input decoding,
       kit-value writing and event notation. It holds no YAML library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OneYamlKit.Adapter</RootNamespace>
    <AssemblyName>OneYamlKit.Adapter.Common</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
