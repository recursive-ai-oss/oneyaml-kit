# Allowlist: everything at the top level is ignored unless listed below, so a
# new file stays out of the repository until it is deliberately added here.
/*
!/.gitignore
!/README.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/bin
!/docs
!/suites
!/tools
!/tests
!/adapters
!/bench
!/.github

# Never commit these anywhere in the tree.
core
core.[0-9]*
core.*.zst
core.*.xz
core.*.lz4
vgcore.*
*.core
perf.data*
*.hprof
*.mdmp
.env
.env.*
*.pem
*.key
*.swp
*~
.DS_Store
__pycache__/
*.pyc
target/
out/
