  "kind": "value",
  "value": [
   {
    "a": "-0x1F",
    "b": "+0x1F",
    "c": "-0o17",
    "d": "0x",
    "e": "0o",
    "f": "0o8",
    "g": "0xG",
    "h": "0X1F",
    "i": "0O17"
   }
  ]
 }
