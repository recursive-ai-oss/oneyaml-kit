 "id": "schema/core-non-decimal-integers-take-no-sign",
 "title": "Hexadecimal and octal forms with a sign, or without digits, are strings",
 "category": "schema",
 "origin": "spec",
 "refs": [
  "YAML 1.2.2 section 10.3.2"
