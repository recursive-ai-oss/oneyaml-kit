{
 "format": "oneyaml-kit-case/2",
 "id": "schema/dollar-keys-use-the-map-form",
 "title": "A mapping with keys that start with $ is written in the map form, never as an object",
 "category": "schema",
 "origin": "spec",
 "refs": [
  "YAML 1.2.2 section 10.3.2"
 ],
 "operation": {
  "type": "value"
 },
 "expect": {
  "kind": "value",
  "value": [
   {
    "$map": [
     [
      "$float",
      "inf"
     ],
     [
      "$map",
      [
       [
        1,
        2
       ]
      ]
     ],
     [
      "$tagged",
      "x"
     ]
    ]
   }
  ]
 }
}
