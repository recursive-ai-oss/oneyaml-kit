<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OneYamlKit.Bench.CSharp</AssemblyName>
    <RootNamespace>OneYamlKit.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <!-- The libraries and the harness run under the collector most programs get: workstation, with
         the background collector off so no background collection lands inside a sample. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The runtime keeps its defaults (tiered compilation, quick JIT, dynamic PGO), as a user's program has them.
         The harness warms every cell until the JIT stops compiling, so what is timed is the optimised code the
         profile produced; see Measure.WarmUp. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Once a lock file exists the restore must match it exactly, so a version only moves on purpose. -->
    <RestoreLockedMode Condition="Exists('$(MSBuildProjectDirectory)/packages.lock.json')">true</RestoreLockedMode>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <!-- oneyaml-csharp is measured only when build.sh passes OneYamlSrc, the checkout named by
       KIT_ONEYAML_CSHARP_SRC; without it nothing below changes and the lock file below applies as before.
       Tools that only load the project (formatting) never link the checkout. The checkout is a project
       reference, which the lock file cannot hold, so a build with the variable restores unlocked (the
       competitor packages are still exact versions) and keeps its lock file in the build's obj folder. -->
  <PropertyGroup Condition="'$(OneYamlSrc)' != ''">
    <OneYamlProject>$([System.IO.Path]::GetFullPath('$(OneYamlSrc)/src/OneYaml/OneYaml.csproj'))</OneYamlProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OneYamlProject)' != '' And Exists('$(OneYamlProject)')">
    <DefineConstants>$(DefineConstants);ONEYAML_LINKED</DefineConstants>
    <NuGetLockFilePath>$(MSBuildProjectExtensionsPath)packages.linked.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
    <OneYamlRevision Condition="'$(OneYamlRevision)' == ''">devel</OneYamlRevision>
  </PropertyGroup>
  <ItemGroup Condition="'$(OneYamlProject)' != '' And Exists('$(OneYamlProject)')">
    <ProjectReference Include="$(OneYamlProject)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OneYamlRevision</_Parameter1>
      <_Parameter2>$(OneYamlRevision)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The self-test build adds deliberately wrong and refusing libraries (src/Libs/Control.cs). It
       is a different assembly name so it can never be mistaken for a measurement build. -->
  <PropertyGroup Condition="'$(Selftest)' == 'true'">
    <DefineConstants>$(DefineConstants);SELFTEST</DefineConstants>
    <AssemblyName>OneYamlKit.Bench.CSharp.Selftest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/Libs/Control.cs" Condition="'$(Selftest)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The libraries under measurement and the harness, each pinned to one exact release. -->
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" />
    <PackageReference Include="SharpYaml" Version="[3.14.0]" />
    <PackageReference Include="VYaml" Version="[1.4.0]" />
    <PackageReference Include="Yaml2JsonNode" Version="[3.0.1]" />
    <PackageReference Include="JsonPatch.Net" Version="[5.0.3]" />
    <PackageReference Include="BenchmarkDotNet" Version="[0.15.8]" />
  </ItemGroup>

</Project>
