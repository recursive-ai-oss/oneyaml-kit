<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OneYamlKit.Bench.CSharp</AssemblyName>
    <RootNamespace>OneYamlKit.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Once a lock file exists the restore must match it exactly, so a version only moves on purpose.
         A build that links the library's source restores without it, because a project reference cannot be locked. -->
    <RestoreLockedMode Condition="Exists('$(MSBuildProjectDirectory)/packages.lock.json')">true</RestoreLockedMode>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <!-- oneyaml-csharp is measured only when build.sh passes OneYamlSrc, the checkout named by
       KIT_ONEYAML_CSHARP_SRC; without it nothing below changes and the lock file applies as before. -->
  <PropertyGroup Condition="'$(OneYamlSrc)' != ''">
    <OneYamlProject>$([System.IO.Path]::GetFullPath('$(OneYamlSrc)/src/OneYaml/OneYaml.csproj'))</OneYamlProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OneYamlProject)' != '' And Exists('$(OneYamlProject)')">
    <DefineConstants>$(DefineConstants);ONEYAML_LINKED</DefineConstants>
    <RestoreLockedMode>false</RestoreLockedMode>
    <!-- Its own lock file goes under obj, so the committed one is left alone. -->
    <NuGetLockFilePath>$(MSBuildProjectExtensionsPath)packages.linked.lock.json</NuGetLockFilePath>
    <OneYamlRevision Condition="'$(OneYamlRevision)' == ''">devel</OneYamlRevision>
  </PropertyGroup>
  <ItemGroup Condition="'$(OneYamlProject)' != '' And Exists('$(OneYamlProject)')">
    <ProjectReference Include="$(OneYamlProject)" />
    <!-- The library's source generator, as a package reference would bring it: it writes the metadata for the
         typed models of the generated row (src/Libs/OneYamlContext.cs). Build time only. -->
    <ProjectReference Include="$([System.IO.Path]::GetFullPath('$(OneYamlSrc)/src/OneYaml.SourceGeneration/OneYaml.SourceGeneration.csproj'))" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OneYamlRevision</_Parameter1>
      <_Parameter2>$(OneYamlRevision)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The self-test build adds deliberately wrong and refusing libraries (src/Libs/Control.cs). It
       is a different assembly name so it can never be mistaken for a measurement build. -->
  <PropertyGroup Condition="'$(Selftest)' == 'true'">
    <DefineConstants>$(DefineConstants);SELFTEST</DefineConstants>
    <AssemblyName>OneYamlKit.Bench.CSharp.Selftest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/Libs/Control.cs" Condition="'$(Selftest)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The libraries under measurement and the harness, each pinned to one exact release. -->
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" />
    <PackageReference Include="SharpYaml" Version="[3.16.0]" />
    <PackageReference Include="VYaml" Version="[1.4.1]" />
    <PackageReference Include="Yaml2JsonNode" Version="[3.0.1]" />
    <PackageReference Include="JsonPatch.Net" Version="[5.0.3]" />
    <PackageReference Include="BenchmarkDotNet" Version="[0.15.8]" />
  </ItemGroup>

</Project>
