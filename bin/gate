#!/bin/sh
# The gate. With no arguments it is the hand-over gate: the kit core plus the areas the
# change touched (files that differ from `main`), a few seconds to a couple of minutes.
#   bin/gate --full        every area and adapter; what CI runs
#   bin/gate --plan        show the steps without running them
#   bin/gate --areas go    named areas instead of choosing by changes
#   bin/gate --jobs 3      areas to run side by side (default 4)
#   bin/gate --budget 150  fail when the hand-over run is slower than this many seconds
# KIT_OUT moves the output directory (default ./out); CARGO_TARGET_DIR, KIT_GO_BIN and
# KIT_DOTNET_ARTIFACTS move build output, which otherwise goes under it. DOTNET names the
# dotnet executable when it is not on PATH.
set -eu
cd "$(dirname "$0")/.."
exec python3 bin/kit gate "$@"
